    <record id="kri_ope_02_05_01" model="risk.kri">
        <field name="name">Nombre d'anomalies détectées lors des contrôles</field>
        <field name="code">KRI-OPE-02-05-01</field>
        <field name="category">accounting</field>
        <field name="measure_unit">number</field>
        <field name="unit">Nombre</field>
        <field name="description">Nombre d'anomalies détectées lors des contrôles internes sur le paramétrage des fonds</field>
        <field name="formula">Identifier le nombre d'anomalies détectées</field>
        <field name="formula_expression">anomalies</field>
        <field name="formula_fields">anomalies</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&lt; 3</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">3</field>
        <field name="threshold_red">5</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_02_05_01')])]"/>
    </record>

    <record id="kri_ope_02_07_01" model="risk.kri">
        <field name="name">Nombre de rejets de l'AMF UEMOA</field>
        <field name="code">KRI-OPE-02-07-01</field>
        <field name="category">compliance</field>
        <field name="measure_unit">number</field>
        <field name="unit">Nombre</field>
        <field name="description">Nombre de rejets ou demandes de complément de la part de l'AMF UEMOA</field>
        <field name="formula">Identifier le nombre de rejets</field>
        <field name="formula_expression">rejections</field>
        <field name="formula_fields">rejections</field>
        <field name="measure_frequency">quarterly</field>
        <field name="tolerance">0</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">1</field>
        <field name="threshold_red">3</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_02_07_01')])]"/>
    </record>

