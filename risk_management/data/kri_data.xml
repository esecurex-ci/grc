        <field name="code">KRI-OPE-03-02-01</field>
        <field name="category">operational</field>
        <field name="measure_unit">number</field>
        <field name="unit">Nombre/mois</field>
        <field name="description">Nombre d'occurrence de la défaillance du système (bugs bloquants)</field>
        <field name="formula">Identifier le nombre de bugs bloquants</field>
        <field name="formula_expression">system_failures</field>
        <field name="formula_fields">system_failures</field>
