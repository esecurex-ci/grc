        <field name="measure_unit">percentage</field>
        <field name="unit">%</field>
        <field name="description">La fréquence des retards (mensuel) dans le calcul de la VL</field>
        <field name="formula">Nombre de retards / Nombre total de VL</field>
        <field name="formula_expression">(delays / total_vl) * 100</field>
        <field name="formula_fields">delays, total_vl</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">[0 - 5%]</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">5</field>
        <field name="threshold_red">10</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_03_01_01')])]"/>
    </record>

