<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- KRI - GESTION DE PORTEFEUILLE                                 -->
    <!-- ============================================================ -->

    <record id="kri_ope_01_01_01" model="risk.kri">
        <field name="name">Ratios règlementaires et limites de diversification</field>
        <field name="code">KRI-OPE-01-01-01</field>
        <field name="category">financial</field>
        <field name="measure_unit">percentage</field>
        <field name="unit">%</field>
        <field name="description">Suivi des ratios règlementaires et des limites de diversification</field>
        <field name="formula">(Ratio actuel / Ratio maximum) × 100</field>
        <field name="formula_expression">(current_ratio / max_ratio) * 100</field>
        <field name="formula_fields">current_ratio, max_ratio</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&lt; 100%</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">80</field>
        <field name="threshold_red">100</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_01_01')])]"/>
    </record>

    <record id="kri_ope_01_02_01" model="risk.kri">
        <field name="name">Indicateurs de Liquidité du Marché</field>
        <field name="code">KRI-OPE-01-02-01</field>
        <field name="category">financial</field>
        <field name="measure_unit">number</field>
        <field name="unit">Volume/jour</field>
        <field name="description">Fréquence des transactions journalières sur une période donnée (ex. 30 jours).</field>
        <field name="formula">Volume moyen des transactions journalières</field>
        <field name="formula_expression">daily_volume</field>
        <field name="formula_fields">daily_volume</field>
        <field name="measure_frequency">daily</field>
        <field name="tolerance">&gt; 1000</field>
        <field name="threshold_green">1000</field>
        <field name="threshold_amber">500</field>
        <field name="threshold_red">100</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_02_01')])]"/>
    </record>

    <record id="kri_ope_01_03_01" model="risk.kri">
        <field name="name">Notation de crédit des émetteurs</field>
        <field name="code">KRI-OPE-01-03-01</field>
        <field name="category">financial</field>
        <field name="measure_unit">number</field>
        <field name="unit">Note</field>
        <field name="description">Suivi des notations des agences (Moody's, S&amp;P, Fitch)</field>
        <field name="formula">Notation de crédit moyenne des émetteurs</field>
        <field name="formula_expression">credit_rating</field>
        <field name="formula_fields">credit_rating</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&gt; 5</field>
        <field name="threshold_green">7</field>
        <field name="threshold_amber">5</field>
        <field name="threshold_red">3</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_03_01')])]"/>
    </record>

    <record id="kri_ope_01_04_01" model="risk.kri">
        <field name="name">Délai moyen de validation des propositions</field>
        <field name="code">KRI-OPE-01-04-01</field>
        <field name="category">operational</field>
        <field name="measure_unit">days</field>
        <field name="unit">Jours</field>
        <field name="description">Délai moyen entre la proposition d'achat et la validation finale</field>
        <field name="formula">Délai moyen = Somme des délais / Nombre de propositions</field>
        <field name="formula_expression">sum_delays / count</field>
        <field name="formula_fields">sum_delays, count</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&lt; 2 jours</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">2</field>
        <field name="threshold_red">5</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_04_01')])]"/>
    </record>

    <record id="kri_ope_01_05_01" model="risk.kri">
        <field name="name">Taux de refus des propositions d'investissement</field>
        <field name="code">KRI-OPE-01-05-01</field>
        <field name="category">operational</field>
        <field name="measure_unit">percentage</field>
        <field name="unit">%</field>
        <field name="description">Pourcentage des propositions d'investissement refusées par le comité</field>
        <field name="formula">(Nombre de refus / Nombre total de propositions) × 100</field>
        <field name="formula_expression">(rejected / total) * 100</field>
        <field name="formula_fields">rejected, total</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&lt; 10%</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">10</field>
        <field name="threshold_red">20</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_05_01')])]"/>
    </record>

    <record id="kri_ope_01_06_01" model="risk.kri">
        <field name="name">Pourcentage de négociations non conformes</field>
        <field name="code">KRI-OPE-01-06-01</field>
        <field name="category">operational</field>
        <field name="measure_unit">percentage</field>
        <field name="unit">%</field>
        <field name="description">Pourcentage des négociations ne respectant pas les règles internes (seuil de prix)</field>
        <field name="formula">(Nombre de négociations non conformes / Total) × 100</field>
        <field name="formula_expression">(non_compliant / total) * 100</field>
        <field name="formula_fields">non_compliant, total</field>
        <field name="measure_frequency">monthly</field>
        <field name="tolerance">&lt; 2%</field>
        <field name="threshold_green">0</field>
        <field name="threshold_amber">2</field>
        <field name="threshold_red">5</field>
        <field name="active">True</field>
        <field name="risk_ids" eval="[(6, 0, [ref('risk_management.risk_ope_01_06_01')])]"/>
    </record>

