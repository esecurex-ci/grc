<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="risk_management.GrcDashboard">
<div class="o_grc_dashboard">
    <h1>
        Cockpit Exécutif GRC
    </h1>
    <div class="row">
        <div class="col-3">
            <div class="card grc-card-primary">
                <div class="card-body">
                    <h2>
                        <t t-esc="state.overall_score"/>
                    </h2>
                    <span>Score GRC</span>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card grc-card-success"
                 t-on-click="openRisks">
                <div class="card-body">
                    <h2>
                        <t t-esc="state.total_risks"/>
                    </h2>
                    <span>Risques</span>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card grc-card-warning">
                <div class="card-body">
                    <h2>
                        <t t-esc="state.critical_risks"/>
                    </h2>
                    <span>Risques Élevés</span>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card grc-card-danger">
                <div class="card-body">
                    <h2>
                        <t t-esc="state.open_incidents"/>
                    </h2>
                    <span>Incidents Ouverts</span>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-6">
            <div class="card">
                <div class="card-header">
                    Taux de Conformité
                </div>
                <div class="card-body">
                    <h1>
                        <t t-esc="
                            state.compliance_rate
                        "/>
                        %
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="card">
                <div class="card-header">
                    Top Risques Élevés (Résiduel)
                </div>
                <div class="card-body">
                    <ul>
                        <t t-foreach="state.top_risks" t-as="risk" t-key="risk.id">
                            <li>
                                <strong><t t-esc="risk.code"/></strong> —
                                <t t-esc="risk.name"/>
                                <span class="badge" style="background:#dc3545;color:white;margin-left:6px;">
                                    Score inhérent: <t t-esc="risk.inherent_score"/>
                                </span>
                            </li>
                        </t>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
</t>
</templates>