<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="risk_management.process_dashboard" owl="1">
        <div class="process-dashboard-container">

            <!-- ========================================= -->
            <!-- CHARGEMENT                               -->
            <!-- ========================================= -->
            <div t-if="state.loading" style="text-align:center;padding:50px;color:#6c757d;">
                <i class="fa fa-spinner fa-spin fa-3x" style="color:#1a237e;"></i>
                <p style="margin-top:15px;">Chargement du tableau de bord...</p>
            </div>

            <div t-else="">

                <!-- ========================================= -->
                <!-- HEADER                                    -->
                <!-- ========================================= -->
                <div class="dashboard-header">
                    <h2>📋 Tableau de Bord Sous Processus</h2>
                    <div class="dashboard-date">
                        <i class="fa fa-calendar" title="Date de mise à jour"/>
                        Généré le <t t-esc="new Date().toLocaleDateString('fr-FR')"/>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- KPI CARDS (toutes cliquables)             -->
                <!-- ========================================= -->
                <div class="row g-2 mb-4">
                    <div class="col-2">
                        <div class="kpi-card" style="cursor:pointer;" title="Voir tous les sous processus" t-on-click="openAllProcesses">
                            <div class="kpi-label">Total Sous Processus</div>
                            <div class="kpi-value"><t t-esc="state.totalProcesses"/></div>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="kpi-card kpi-high" style="cursor:pointer;" title="Voir les sous processus à risque résiduel élevé"
                             t-on-click="() => openProcessesByIds(state.residualHighProcessIds, 'Sous processus à risque résiduel élevé')">
                            <div class="kpi-label">🔴 Élevés</div>
                            <div class="kpi-value"><t t-esc="state.high"/></div>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="kpi-card kpi-medium" style="cursor:pointer;" title="Voir les sous processus à risque résiduel modéré"
                             t-on-click="() => openProcessesByIds(state.residualMediumProcessIds, 'Sous processus à risque résiduel modéré')">
                            <div class="kpi-label">🟡 Modérés</div>
                            <div class="kpi-value"><t t-esc="state.medium"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="kpi-card kpi-low" style="cursor:pointer;" title="Voir les sous processus à risque résiduel faible"
                             t-on-click="() => openProcessesByIds(state.residualLowProcessIds, 'Sous processus à risque résiduel faible')">
                            <div class="kpi-label">🟢 Faibles</div>
                            <div class="kpi-value"><t t-esc="state.low"/></div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="kpi-card kpi-avg" style="cursor:pointer;" title="Voir les sous processus à risque résiduel élevé"
                             t-on-click="() => openProcessesByIds(state.residualHighProcessIds, 'Sous processus à risque résiduel élevé')">
                            <div class="kpi-label">🔴 Taux de risque élevé</div>
                            <div class="kpi-value">
                                <t t-esc="state.high"/> / <t t-esc="state.totalProcesses"/>
                            </div>
                            <div class="kpi-progress">
                                <div class="progress-track">
                                    <div class="progress-fill" t-attf-style="width:#{(state.high / Math.max(state.totalProcesses, 1)) * 100}%;background:#dc3545;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- DONUT CHARTS (Répartition) - cliquables   -->
                <!-- ========================================= -->
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="chart-card">
                            <h5 class="chart-title">📊 Répartition des Sous Processus par Niveau de Risque</h5>
                            <div class="donut-grid">
                                <div class="donut-item" t-foreach="state.riskDistribution" t-as="item" t-key="item.key"
                                     style="cursor:pointer;"
                                     t-att-title="'Voir les sous processus : ' + item.label"
                                     t-on-click="() => openProcessesByIds(item.key === 'high' ? state.residualHighProcessIds : (item.key === 'medium' ? state.residualMediumProcessIds : state.residualLowProcessIds), 'Sous processus à risque résiduel ' + item.label.toLowerCase())">
                                    <div t-out="renderSingleDonut(item, state.totalProcesses)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- MATRICE DES PROCESSUS PAR CATÉGORIE      -->
                <!-- (chaque cellule non-vide est cliquable)   -->
                <!-- ========================================= -->
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="chart-card">
                            <h5 class="chart-title">🔥 Matrice des Sous Processus par Macro-Processus</h5>
                            <div class="table-responsive">
                                <table class="matrix-table">
                                    <thead>
                                        <tr>
                                            <th>Catégorie ↓</th>
                                            <th>🔴 Élevés</th>
                                            <th>🟡 Modérés</th>
                                            <th>🟢 Faibles</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="Object.keys(state.matrix)" t-as="cat" t-key="cat">
                                            <td>
                                                <strong style="cursor:pointer;" title="Voir tous les sous processus de cette catégorie"
                                                        t-on-click="() => openProcessesByIds(state.categoryProcessIds[cat], formatCategory(cat))">
                                                    <t t-esc="formatCategory(cat)"/>
                                                </strong>
                                            </td>
                                            <td t-attf-class="cell-{{state.matrix[cat].high > 0 ? 'danger' : 'empty'}}"
                                                t-attf-style="#{state.matrix[cat].high > 0 ? 'cursor:pointer;' : ''}"
                                                t-att-title="state.matrix[cat].high > 0 ? 'Voir ces sous processus' : ''"
                                                t-on-click="() => openProcessesByIds(getCategoryLevelIds(cat, 'high'), formatCategory(cat) + ' — risque élevé')">
                                                <t t-esc="state.matrix[cat].high || 0"/>
                                            </td>
                                            <td t-attf-class="cell-{{state.matrix[cat].medium > 0 ? 'warning' : 'empty'}}"
                                                t-attf-style="#{state.matrix[cat].medium > 0 ? 'cursor:pointer;' : ''}"
                                                t-att-title="state.matrix[cat].medium > 0 ? 'Voir ces sous processus' : ''"
                                                t-on-click="() => openProcessesByIds(getCategoryLevelIds(cat, 'medium'), formatCategory(cat) + ' — risque modéré')">
                                                <t t-esc="state.matrix[cat].medium || 0"/>
                                            </td>
                                            <td t-attf-class="cell-{{state.matrix[cat].low > 0 ? 'success' : 'empty'}}"
                                                t-attf-style="#{state.matrix[cat].low > 0 ? 'cursor:pointer;' : ''}"
                                                t-att-title="state.matrix[cat].low > 0 ? 'Voir ces sous processus' : ''"
                                                t-on-click="() => openProcessesByIds(getCategoryLevelIds(cat, 'low'), formatCategory(cat) + ' — risque faible')">
                                                <t t-esc="state.matrix[cat].low || 0"/>
                                            </td>
                                            <td>
                                                <strong style="cursor:pointer;" title="Voir tous les sous processus de cette catégorie"
                                                        t-on-click="() => openProcessesByIds(state.categoryProcessIds[cat], formatCategory(cat))">
                                                    <t t-esc="state.matrix[cat].total || 0"/>
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr style="font-weight:bold;background:#f8f9fa;">
                                            <td style="cursor:pointer;" title="Voir tous les sous processus" t-on-click="openAllProcesses">Total</td>
                                            <td style="cursor:pointer;" title="Voir les sous processus à risque élevé"
                                                t-on-click="() => openProcessesByIds(state.residualHighProcessIds, 'Sous processus à risque résiduel élevé')">
                                                <t t-esc="state.high"/>
                                            </td>
                                            <td style="cursor:pointer;" title="Voir les sous processus à risque modéré"
                                                t-on-click="() => openProcessesByIds(state.residualMediumProcessIds, 'Sous processus à risque résiduel modéré')">
                                                <t t-esc="state.medium"/>
                                            </td>
                                            <td style="cursor:pointer;" title="Voir les sous processus à risque faible"
                                                t-on-click="() => openProcessesByIds(state.residualLowProcessIds, 'Sous processus à risque résiduel faible')">
                                                <t t-esc="state.low"/>
                                            </td>
                                            <td style="cursor:pointer;" title="Voir tous les sous processus" t-on-click="openAllProcesses">
                                                <t t-esc="state.totalProcesses"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- DEUX COLONNES : RISQUE ÉLEVÉ + TOP 5     -->
                <!-- ========================================= -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="chart-card">
                            <h5 class="chart-title">🎯 Sous Processus à Risque Inhérent Élevé</h5>
                            <div t-if="state.highRiskProcesses.length > 0">
                                <div class="risk-item" t-foreach="state.highRiskProcesses" t-as="process" t-key="process.id">
                                    <div class="process-item" style="cursor:pointer;" t-on-click="() => openProcessById(process.id)">
                                        <div class="process-info">
                                            <span class="risk-level-badge high">🔴 Élevé</span>
                                            <span class="process-name"><t t-esc="process.name"/></span>
                                            <span class="process-code"><t t-esc="process.code"/></span>
                                        </div>
                                        <div class="process-stats">
                                            <span class="badge badge-danger"><t t-esc="process.count"/> risques</span>
                                            <span class="process-owner"><i class="fa fa-user" title="Propriétaire"/> <t t-esc="process.owner"/></span>
                                        </div>
                                    </div>
                                </div>
                                <a href="#" class="view-all-link"
                                   t-on-click.prevent="() => openProcessesByIds(state.inherentHighProcessIds, 'Sous processus à risque inhérent élevé')">
                                    Voir tous les sous processus à risque inhérent élevé →
                                </a>
                            </div>
                            <div t-else="" style="text-align:center;padding:20px;color:#28a745;">
                                ✅ Aucun sous processus à risque inhérent élevé
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="chart-card">
                            <h5 class="chart-title">📊 Sous Processus à Risque Résiduel Élevé</h5>
                            <div t-if="state.topProcesses.length > 0">
                                <div class="risk-item" t-foreach="state.topProcesses" t-as="process" t-key="process.id">
                                    <div class="process-item" style="cursor:pointer;" t-on-click="() => openProcessById(process.id)">
                                        <div class="process-info">
                                            <span class="rank-badge">#<t t-esc="process_index + 1"/></span>
                                            <span t-attf-class="risk-level-badge #{process.level}">
                                                <t t-esc="getLevelBadge(process.level)"/>
                                            </span>
                                            <span class="process-name"><t t-esc="process.name"/></span>
                                            <span class="process-code"><t t-esc="process.code"/></span>
                                        </div>
                                        <div class="process-stats">
                                            <span class="badge badge-secondary"><t t-esc="process.count"/> risques</span>
                                            <span class="process-owner"><i class="fa fa-user" title="Propriétaire"/> <t t-esc="process.owner"/></span>
                                        </div>
                                    </div>
                                </div>
                                <a href="#" class="view-all-link"
                                   t-on-click.prevent="() => openProcessesByIds(state.residualHighProcessIds, 'Sous processus à risque résiduel élevé')">
                                    Voir tous les sous processus à risque résiduel élevé →
                                </a>
                            </div>
                            <div t-else="" style="text-align:center;padding:20px;color:#28a745;">
                                ✅ Aucun sous processus à risque résiduel élevé
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- BARRES HORIZONTALES (cliquables)          -->
                <!-- ========================================= -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="chart-card">
                            <h5 class="chart-title">📊 Distribution des Sous Processus par niveau de Risque Résiduel</h5>
                            <div class="bar-chart">
                                <div class="bar-row" t-foreach="state.riskDistribution" t-as="item" t-key="item.key"
                                     style="cursor:pointer;" t-att-title="'Voir les sous processus : ' + item.label"
                                     t-on-click="() => openProcessesByIds(item.key === 'high' ? state.residualHighProcessIds : (item.key === 'medium' ? state.residualMediumProcessIds : state.residualLowProcessIds), 'Sous processus à risque résiduel ' + item.label.toLowerCase())">
                                    <span class="bar-label"><t t-esc="item.label"/></span>
                                    <div class="bar-track">
                                        <div class="bar-fill" t-attf-style="width:#{(item.value / getMaxDistribution()) * 100}%;background:#{item.color};">
                                            <span class="bar-value-label"><t t-esc="item.value"/></span>
                                        </div>
                                    </div>
                                    <span class="bar-value"><t t-esc="item.value"/></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="chart-card">
                            <h5 class="chart-title">📈 Répartition des Sous Processus par Macro-Processus</h5>
                            <div class="category-bars">
                                <div class="category-row" t-foreach="Object.entries(state.categoryStats)" t-as="item" t-key="item[0]"
                                     style="cursor:pointer;" t-att-title="'Voir les sous processus : ' + item[0]"
                                     t-on-click="() => openProcessesByIds(state.categoryProcessIds[item[0]], item[0])">
                                    <span class="cat-label"><t t-esc="item[0]"/></span>
                                    <div class="cat-track">
                                        <div class="cat-fill" t-attf-style="width:#{(item[1] / getCategoryMax()) * 100}%;background:#1a237e;"></div>
                                    </div>
                                    <span class="cat-value"><t t-esc="item[1]"/></span>
                                    <span class="cat-percent" t-if="state.totalProcesses > 0">
                                        (<t t-esc="Math.round((item[1] / state.totalProcesses) * 100)"/>%)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- PROCESSUS SANS RISQUE (chaque ligne cliquable) -->
                <!-- ========================================= -->
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="chart-card">
                            <h5 class="chart-title">⬜ Sous Processus à risque résiduel faible</h5>
                            <div t-if="state.processesWithoutRisk.length > 0">
                                <div class="no-risk-grid">
                                    <div class="no-risk-item" t-foreach="state.processesWithoutRisk" t-as="process" t-key="process.id"
                                         style="cursor:pointer;" t-on-click="() => openProcessById(process.id)">
                                        <span class="no-risk-code"><t t-esc="process.code"/></span>
                                        <span class="no-risk-name"><t t-esc="process.name"/></span>
                                        <span class="badge badge-secondary"><t t-esc="process.category"/></span>
                                    </div>
                                </div>
                            </div>
                            <div t-else="" style="text-align:center;padding:20px;color:#28a745;">
                                ✅ Tous les sous processus ont des risques résiduels faibles ou modérés
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- RAPPORT NARRATIF                         -->
                <!-- ========================================= -->
                <div class="row g-3">
                    <div class="col-12">
                        <div class="chart-card narrative-card">
                            <h5 class="chart-title">📝 Rapport Narratif - Principaux changements</h5>
                            <div t-foreach="state.narratives" t-as="item" t-key="item_index">
                                <div class="narrative-item">
                                    <span class="narr-icon"><t t-esc="item.icon"/></span>
                                    <span class="narr-text"><t t-esc="item.text"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================= -->
                <!-- LÉGENDE                                  -->
                <!-- ========================================= -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="dashboard-legend">
                            <span><span class="legend-color" style="background:#dc3545;"></span> Élevé</span>
                            <span><span class="legend-color" style="background:#ffc107;"></span> Modéré</span>
                            <span><span class="legend-color" style="background:#28a745;"></span> Faible</span>
                            <span class="legend-separator">|</span>
                            <span><i class="fa fa-user" title="Propriétaire"></i> Propriétaire</span>
                            <span><i class="fa fa-exclamation-triangle" title="Risques"></i> Nombre de risques</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
