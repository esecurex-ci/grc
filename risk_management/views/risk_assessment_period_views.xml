<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_risk_assessment_period_list" model="ir.ui.view">
        <field name="name">risk.assessment.period.list</field>
        <field name="model">risk.assessment.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="assessment_count"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_risk_assessment_period_form" model="ir.ui.view">
        <field name="name">risk.assessment.period.form</field>
        <field name="model">risk.assessment.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" string="Clôturer" type="object"
                            class="btn-primary" invisible="state != 'open'"
                            confirm="Clôturer cette campagne ? Les évaluations en cours resteront inchangées."/>
                    <button name="action_export" string="Exporter (Excel)" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <!-- ============================================ -->
                    <!-- EN-TÊTE : Campagne + Période                -->
                    <!-- ============================================ -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la campagne..."/>
                        </h1>
                        <span class="oe_subtitle">
                            <field name="code" placeholder="Code"/> —
                            <field name="date_start" nolabel="1"/> → <field name="date_end" nolabel="1"/>
                        </span>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- ============================================ -->
                    <!-- ZONE RÉCAPITULATIVE (KPI)                    -->
                    <!-- ============================================ -->
                    <div class="row g-2 mt-2 mb-3">
                        <div class="col-3">
                            <div class="card text-center h-100" style="border-color:#1a237e;">
                                <div class="card-body">
                                    <h2 class="mb-0" style="color:#1a237e;"><field name="total_risk_count" nolabel="1"/></h2>
                                    <span class="text-muted">Nb risques total</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center h-100" style="border-color:#dc3545;">
                                <div class="card-body">
                                    <h2 class="mb-0" style="color:#dc3545;"><field name="high_risk_count" nolabel="1"/></h2>
                                    <span class="text-muted">Élevés</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center h-100" style="border-color:#28a745;">
                                <div class="card-body">
                                    <h2 class="mb-0" style="color:#28a745;"><field name="assessment_count" nolabel="1"/></h2>
                                    <span class="text-muted">Nb évaluations</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="card text-center h-100" style="border-color:#6f42c1;">
                                <div class="card-body">
                                    <h2 class="mb-0" style="color:#6f42c1;"><field name="pending_risk_count" nolabel="1"/></h2>
                                    <span class="text-muted">Restant à évaluer</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- PROGRESSION DE LA CAMPAGNE                   -->
                    <!-- ============================================ -->
                    <div class="mb-3">
                        <label for="progress_percent" string="Progression de l'évaluation" class="text-muted small mb-1"/>
                        <field name="progress_percent" widget="progressbar" readonly="1" nolabel="1"/>
                    </div>

                    <!-- ============================================ -->
                    <!-- TABLEAU PRINCIPAL (risques + évaluations)    -->
                    <!-- ============================================ -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <field name="only_my_risks" widget="boolean_toggle"/>
                        <span>Filtrer : afficher uniquement mes risques (mon/mes processus)</span>
                    </div>

                    <field name="campaign_risk_ids" context="{'period_id': id}" readonly="1">
                        <list decoration-success="inherent_level == 'low'"
                              decoration-warning="inherent_level == 'medium'"
                              decoration-danger="inherent_level == 'high'"
                              default_order="inherent_level desc">
                            <field name="code"/>
                            <field name="name" string="Risque"/>
                            <field name="inherent_level" string="Niv. inhérent" widget="badge"/>
                            <field name="assessment_residual_level_for_period" string="Niv. résiduel" widget="badge"/>
                            <field name="assessment_state_for_period" string="Statut"/>
                            <button name="action_start_assessment" type="object"
                                    string="Évaluer" class="btn-sm btn-primary"/>
                        </list>
                    </field>
                    <p class="text-muted small mt-1">
                        Astuce : cliquez sur l'en-tête "Niv. inhérent" pour trier par niveau de risque.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_risk_assessment_period_search" model="ir.ui.view">
        <field name="name">risk.assessment.period.search</field>
        <field name="model">risk.assessment.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="draft" string="Brouillon" domain="[('state','=','draft')]"/>
                <filter name="open" string="Ouverte" domain="[('state','=','open')]"/>
                <filter name="closed" string="Clôturée" domain="[('state','=','closed')]"/>
            </search>
        </field>
    </record>
</odoo>