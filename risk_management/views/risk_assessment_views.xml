<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- VUE LISTE - ÉVALUATIONS                   -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_list" model="ir.ui.view">
        <field name="name">risk.assessment.list</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <list
                decoration-success="risk_level == 'low'"
                decoration-warning="risk_level == 'medium'"
                decoration-danger="risk_level == 'high'"
                decoration-muted="state == 'closed'">

                <field name="name" string="Évaluation"/>
                <field name="assessment_date" string="Date"/>
                <field name="risk_id" string="Risque"/>
                <field name="inherent_score" string="Score inhérent" sum="Total"/>
                <field name="risk_level" string="Niveau résiduel" widget="badge"/>
                <field name="over_appetite" string="Hors appétit" widget="boolean"/>
                <field name="state" string="Statut" widget="badge"/>
                <field name="assessor_id" string="Évaluateur"/>
                <field name="treatment_plan_count" string="Plans" widget="statinfo"/>

            </list>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE KANBAN - ÉVALUATIONS                  -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_kanban" model="ir.ui.view">
        <field name="name">risk.assessment.kanban</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="assessment_date"/>
                <field name="risk_id"/>
                <field name="inherent_score"/>
                <field name="risk_level"/>
                <field name="state"/>
                <field name="assessor_id"/>
                <field name="over_appetite"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <span class="fa fa-clipboard" style="font-size:32px;" title="Évaluation"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="risk_id"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div style="display:flex;gap:10px;margin:5px 0;">
                                        <div style="background:#dc3545;padding:2px 10px;border-radius:4px;color:white;font-size:11px;">
                                            <span style="font-weight:bold;">🔴 Inhérent:</span>
                                            <span t-esc="record.inherent_score.raw_value"/>
                                        </div>
                                        <div t-attf-style="background:#{record.risk_level.raw_value == 'high' ? '#dc3545' : record.risk_level.raw_value == 'medium' ? '#ffc107' : '#28a745'};padding:2px 10px;border-radius:4px;color:white;font-size:11px;">
                                            <span style="font-weight:bold;">🛡️ Résiduel:</span>
                                            <t t-esc="record.risk_level.raw_value == 'high' ? 'Élevé' : record.risk_level.raw_value == 'medium' ? 'Modéré' : 'Faible'"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_tags">
                                        <span class="badge" t-attf-class="badge badge-secondary">
                                            <field name="state"/>
                                        </span>
                                        <t t-if="record.over_appetite.raw_value" class="badge badge-danger">
                                            ⚠️ Hors appétit
                                        </t>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fa fa-user" title="Évaluateur"/> <field name="assessor_id"/>
                                        <i class="fa fa-calendar" style="margin-left:10px;" title="Date"/> <field name="assessment_date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE FORMULAIRE - ÉVALUATIONS              -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_form" model="ir.ui.view">
        <field name="name">risk.assessment.form</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Soumettre" type="object" class="btn-primary"
                            invisible="state not in ['draft']"/>
                    <button name="action_review" string="Réviser" type="object" class="btn-info"
                            invisible="state not in ['submitted']"/>
                    <button name="action_approve" string="Approuver" type="object" class="btn-success"
                            invisible="state not in ['reviewed']"/>
                    <button name="action_close" string="Fermer" type="object" class="btn-danger"
                            invisible="state not in ['approved']"/>
                    <button name="action_reset" string="Réinitialiser" type="object" class="btn-secondary"
                            invisible="state in ['draft', 'closed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed,approved,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Numéro d'évaluation..."/>
                        </h1>
                        <span class="oe_subtitle">
                            <field name="assessment_date"/>
                        </span>
                    </div>

                    <group name="header_group">
                        <group name="left_group">
                            <field name="risk_id" required="1" options="{'no_create': True}"/>
                            <field name="period_id" required="1"/>
                            <field name="assessor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="right_group">
                            <field name="state" widget="badge"/>
                            <field name="risk_level" widget="badge"/>
                            <field name="over_appetite" widget="boolean"/>
                            <field name="appetite" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📊 Évaluation" name="evaluation">
                            <group string="🔴 Évaluation inhérente">
                                <div class="alert alert-danger" role="alert" style="margin-bottom:10px;">
                                    <i class="fa fa-exclamation-triangle" title="Attention"/>
                                    <strong>Évaluation avant contrôles</strong>
                                    <span class="text-muted"> - Score maximum possible</span>
                                </div>
                                <group>
                                    <group>
                                        <field name="inherent_probability"/>
                                        <field name="inherent_impact"/>
                                        <field name="inherent_level" widget="badge" readonly="1"/>
                                    </group>
                                    <group>
                                        <div style="background:#dc3545;border-radius:8px;padding:15px;color:white;text-align:center;">
                                            <strong>Score inhérent</strong>
                                            <div style="font-size:28px;font-weight:800;">
                                                <field name="inherent_score" readonly="1"/>
                                            </div>
                                        </div>
                                    </group>
                                </group>
                            </group>

                            <group string="🔒 Contrôles">
                                <div class="alert alert-info" role="alert" style="margin-bottom:10px;">
                                    <i class="fa fa-shield" title="Contrôles"/>
                                    <strong>Efficacité des contrôles</strong>
                                    <span class="text-muted"> - Impact sur le risque résiduel</span>
                                </div>
                                <group>
                                    <field name="control_effectiveness_level" widget="radio"/>
                                </group>
                            </group>

                            <group string="🟢 Évaluation résiduelle">
                                <div class="alert alert-success" role="alert" style="margin-bottom:10px;">
                                    <i class="fa fa-check-circle" title="Validé"/>
                                    <strong>Évaluation après contrôles</strong>
                                    <span class="text-muted"> - Niveau déterminé par la matrice (pas de score numérique)</span>
                                </div>
                                <group>
                                    <group>
                                        <field name="control_effectiveness_level" readonly="1"/>
                                    </group>
                                    <group>
                                        <div invisible="risk_level != 'high'" style="background:#dc3545;border-radius:8px;padding:15px;color:white;text-align:center;">
                                            <strong>Niveau résiduel</strong>
                                            <div style="font-size:22px;font-weight:800;">
                                                <field name="risk_level" readonly="1"/>
                                            </div>
                                        </div>
                                        <div invisible="risk_level != 'medium'" style="background:#ffc107;border-radius:8px;padding:15px;color:#212529;text-align:center;">
                                            <strong>Niveau résiduel</strong>
                                            <div style="font-size:22px;font-weight:800;">
                                                <field name="risk_level" readonly="1"/>
                                            </div>
                                        </div>
                                        <div invisible="risk_level != 'low'" style="background:#28a745;border-radius:8px;padding:15px;color:white;text-align:center;">
                                            <strong>Niveau résiduel</strong>
                                            <div style="font-size:22px;font-weight:800;">
                                                <field name="risk_level" readonly="1"/>
                                            </div>
                                        </div>
                                    </group>
                                </group>
                                <div style="margin-top:10px;padding:10px;background:#fff;border-radius:8px;text-align:center;border:1px solid #dee2e6;">
                                    <span style="font-size:14px;">
                                        <span style="color:#dc3545;">🔴 Inhérent: <strong><field name="inherent_level" widget="badge"/></strong></span>
                                        <span style="margin:0 15px;">➡️</span>
                                        <span style="color:#28a745;">🛡️ Résiduel: <strong><field name="risk_level" widget="badge"/></strong></span>
                                    </span>
                                </div>
                            </group>
                        </page>

                        <page string="🎯 Appétit" name="appetite">
                            <group>
                                <group>
                                    <field name="appetite" readonly="1"/>
                                    <field name="over_appetite" widget="boolean"/>
                                </group>
                                <group>
                                    <div style="margin-top:10px;padding:15px;border-radius:8px;border:1px solid #dee2e6;">
                                        <div style="font-weight:bold;margin-bottom:5px;">
                                            <field name="over_appetite" widget="boolean"/>
                                        </div>
                                        <div style="font-size:13px;color:#6c757d;">
                                            Le niveau de risque résiduel est comparé à l'appétit au risque défini.
                                        </div>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="📋 Traitement" name="treatment">
                            <group>
                                <field name="treatment_strategy" widget="selection"/>
                                <field name="comment" placeholder="Commentaires sur le traitement..."/>
                            </group>
                            <group string="Plans d'action" name="action_plans">
                                <div style="margin-bottom:10px;padding:10px;background:#e8f4fd;border-radius:6px;">
                                    <i class="fa fa-info-circle" title="Information"/>
                                    Plans d'action liés à ce risque (avec suivi détaillé des tâches).
                                </div>
                                <field name="action_plan_ids">
                                    <list>
                                        <field name="code"/>
                                        <field name="name" string="Plan"/>
                                        <field name="owner_id" string="Responsable"/>
                                        <field name="deadline" string="Date limite"/>
                                        <field name="state" widget="badge"/>
                                        <field name="task_progress" string="Avancement" widget="progressbar"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="🗄️ Anciens plans (obsolète)" name="legacy_treatment">
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-exclamation-triangle" title="Attention"/>
                                <strong>Mécanisme obsolète</strong> — conservé uniquement pour l'historique.
                                Utilise l'onglet "Traitement" (plans d'action) pour tout nouveau suivi.
                            </div>
                            <field name="treatment_plan_ids" context="{'default_assessment_id': id}">
                                <list>
                                    <field name="name" string="Plan"/>
                                    <field name="owner_id" string="Responsable"/>
                                    <field name="target_date" string="Date limite"/>
                                    <field name="state" widget="badge"/>
                                    <field name="progress" string="Avancement" widget="progressbar"/>
                                </list>
                            </field>
                        </page>

                        <page string="💬 Historique" name="history">
                            <div style="max-height:300px;overflow-y:auto;border:1px solid #e8eaf6;border-radius:6px;padding:5px;">
                                <field name="message_follower_ids" nolabel="1"/>
                                <field name="activity_ids" nolabel="1"/>
                                <field name="message_ids" nolabel="1"/>
                            </div>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE RECHERCHE - ÉVALUATIONS (VIDE)       -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_search" model="ir.ui.view">
        <field name="name">risk.assessment.search</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Numéro"/>
                <field name="risk_id" string="Risque"/>
                <field name="assessor_id" string="Évaluateur"/>
                <field name="state" string="Statut"/>
                <field name="risk_level" string="Niveau"/>
            </search>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE PIVOT - ÉVALUATIONS                   -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_pivot" model="ir.ui.view">
        <field name="name">risk.assessment.pivot</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="risk_level" type="col"/>
                <field name="assessment_date" type="row" interval="month"/>
                <field name="inherent_score" type="measure"/>
                <field name="risk_id" type="measure" operator="count"/>
            </pivot>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE GRAPHIQUE - ÉVALUATIONS               -->
    <!-- ========================================= -->
    <record id="view_risk_assessment_graph" model="ir.ui.view">
        <field name="name">risk.assessment.graph</field>
        <field name="model">risk.assessment</field>
        <field name="arch" type="xml">
            <graph>
                <field name="assessment_date" type="row"/>
                <field name="inherent_score" type="measure"/>
                <field name="risk_id" type="measure" operator="count"/>
            </graph>
        </field>
    </record>

</odoo>