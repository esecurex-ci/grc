<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ✅ Historique des versions PCA (ISO 22301 §8.4 — caractère évolutif
         du plan). Les instantanés sont créés uniquement par
         risk.bcp.plan.action_revise() : create="0" pour éviter qu'un
         utilisateur en saisisse manuellement (ce qui casserait la
         numérotation de version_number), et seul 'changelog' reste
         modifiable après création. -->

    <record id="view_risk_bcp_plan_version_list" model="ir.ui.view">
        <field name="name">risk.bcp.plan.version.list</field>
        <field name="model">risk.bcp.plan.version</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="bcp_id"/>
                <field name="version_label"/>
                <field name="snapshot_date"/>
                <field name="author_id"/>
                <field name="state_at_snapshot"/>
                <field name="changelog"/>
            </list>
        </field>
    </record>

    <record id="view_risk_bcp_plan_version_form" model="ir.ui.view">
        <field name="name">risk.bcp.plan.version.form</field>
        <field name="model">risk.bcp.plan.version</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="version_label"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="bcp_id" readonly="1"/>
                            <field name="snapshot_date" readonly="1"/>
                            <field name="author_id" readonly="1"/>
                            <field name="state_at_snapshot" readonly="1"/>
                        </group>
                        <group>
                            <field name="target_rto_hours_snapshot" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="changelog" placeholder="Motif de cette révision..."/>
                    </group>
                    <notebook>
                        <page string="Critères d'Activation (figé)">
                            <field name="activation_criteria_snapshot" readonly="1"/>
                        </page>
                        <page string="Stratégie de Reprise (figée)">
                            <field name="recovery_strategy_snapshot" readonly="1"/>
                        </page>
                        <page string="Communication (figée)">
                            <field name="communication_plan_snapshot" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
