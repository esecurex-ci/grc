<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_risk_bcp_plan_list" model="ir.ui.view">
        <field name="name">risk.bcp.plan.list</field>
        <field name="model">risk.bcp.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="process_id"/>
                <field name="owner_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_risk_bcp_plan_form" model="ir.ui.view">
        <field name="name">risk.bcp.plan.form</field>
        <field name="model">risk.bcp.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- ⚠️ 'state' était auparavant un simple champ éditable dans
                         le corps du formulaire : n'importe qui pouvait passer un
                         PCA à 'Approved' sans validation, alors que ce statut
                         alimente directement le taux de couverture PCA du
                         tableau de bord Résilience. -->
                    <button name="action_approve"
                            string="Valider"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            string="Remettre en brouillon"
                            type="object"
                            invisible="state != 'approved'"/>
                    <!-- ⚠️ "Le PCA a un caractère évolutif" : réviser un plan
                         déjà approuvé ne doit pas écraser silencieusement ce
                         qui a été approuvé (et potentiellement déjà testé) —
                         ce bouton archive le contenu actuel dans l'historique
                         des versions avant de rouvrir le plan en brouillon. -->
                    <button name="action_revise"
                            string="Réviser (nouvelle version)"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'approved'"/>
                    <button name="action_obsolete"
                            string="Marquer obsolète"
                            type="object"
                            invisible="state == 'obsolete'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,obsolete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_resources"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-server">
                            <field name="resource_count"
                                   widget="statinfo"
                                   string="Ressources"/>

                        </button>

                        <!-- ⚠️ Le lien risk.exercise.bcp_id existait déjà (utilisé
                             pour calculer last_test_date/last_tested_rto_hours)
                             mais n'était accessible depuis aucun écran du PCA. -->
                        <button name="action_view_tests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-flask">
                            <field name="test_count"
                                   widget="statinfo"
                                   string="Tests"/>
                        </button>

                        <!-- ✅ Historique des versions (caractère évolutif du PCA) -->
                        <button name="action_view_versions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history">
                            <field name="version_count"
                                   widget="statinfo"
                                   string="Historique"/>
                        </button>

                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="process_id"/>
                            <field name="owner_id"/>
                            <field name="version_number" readonly="1" string="Version actuelle"/>
                        </group>
                        <!-- ✅ Alignement ISO 22301 §8.4 -->
                        <group>
                            <field name="bia_id"/>
                            <field name="drp_ids" widget="many2many_tags"/>
                            <field name="target_rto_hours"/>
                            <field name="last_tested_rto_hours"/>
                            <field name="last_test_date"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Critères d'Activation">
                            <field name="activation_criteria"/>
                        </page>
                        <page string="Stratégie de Reprise">
                            <field name="recovery_strategy"/>
                        </page>

                        <page string="Communication">

                            <field name="communication_plan"/>

                        </page>

                        <page string="Ressources / Équipe de continuité">

                            <field name="resource_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="resource_type"/>

                                    <field name="role"/>

                                    <field name="employee_id"/>

                                    <field name="partner_id"/>

                                    <field name="contact_info"/>

                                </list>

                            </field>

                        </page>

                        <page string="Revue &amp; Approbation">
                            <group>
                                <group string="Revue périodique">
                                    <field name="last_review_date"/>
                                    <field name="next_review_date"/>
                                </group>
                                <group string="Approbation">
                                    <field name="approved_date" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                </group>
                            </group>
                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>

</odoo>