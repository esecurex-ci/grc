<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_risk_kri_formula_test_wizard_form" model="ir.ui.view">
        <field name="name">risk.kri.formula.test.wizard.form</field>
        <field name="model">risk.kri.formula.test.wizard</field>
        <field name="arch" type="xml">
            <form string="🧪 Tester la formule">
                <sheet>
                    <div class="oe_title">
                        <h1>🧪 Tester la formule</h1>
                        <p class="text-muted">
                            Vérifiez le comportement d'une formule sur des valeurs d'exemple, avant de l'appliquer réellement à un KRI.
                        </p>
                    </div>

                    <group>
                        <field name="formula_expression"/>
                        <field name="formula_fields"/>
                    </group>

                    <group string="📝 Paramètres de test" colspan="2">
                        <field name="parameter_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Nom du paramètre"/>
                                <field name="value" string="Valeur"/>
                                <field name="description" string="Description" optional="show"/>
                            </list>
                        </field>
                    </group>

                    <group string="📈 Résultat du test" colspan="2">
                        <div invisible="not test_message or not test_success" style="background:#d4edda;border-radius:8px;padding:15px;text-align:center;border:1px solid #dee2e6;">
                            <div style="font-size:14px;color:#6c757d;">Résultat</div>
                            <div style="font-size:32px;font-weight:800;color:#1a237e;">
                                <field name="test_result" readonly="1" nolabel="1"/>
                            </div>
                            <div style="margin-top:6px;">
                                <field name="test_message" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <div invisible="not test_message or test_success" style="background:#f8d7da;border-radius:8px;padding:15px;text-align:center;border:1px solid #dee2e6;">
                            <div style="font-size:14px;color:#6c757d;">Résultat</div>
                            <div style="font-size:32px;font-weight:800;color:#1a237e;">
                                <field name="test_result" readonly="1" nolabel="1"/>
                            </div>
                            <div style="margin-top:6px;">
                                <field name="test_message" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <group>
                            <field name="test_success" readonly="1" widget="boolean"/>
                            <field name="execution_time" readonly="1" string="Temps d'exécution (ms)"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_test_formula" string="🧪 Tester" type="object" class="btn-primary"/>
                        <button string="Fermer" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>