<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_risk_kri_compute_wizard_form" model="ir.ui.view">
        <field name="name">risk.kri.compute.wizard.form</field>
        <field name="model">risk.kri.compute.wizard</field>
        <field name="arch" type="xml">
            <form string="🧮 Calcul du KRI">
                <sheet>
                    <div class="oe_title">
                        <h1>🧮 Calcul du KRI</h1>
                        <p class="text-muted">
                            Calculez automatiquement la valeur du KRI à partir de la formule définie.
                        </p>
                    </div>

                    <group>
                        <group>
                            <field name="kri_id" readonly="1"/>
                            <field name="kri_code" readonly="1" string="Code"/>
                            <field name="unit" readonly="1" string="Unité"/>
                        </group>
                        <group>
                            <field name="measure_unit" readonly="1" string="Type de mesure"/>
                            <field name="measure_date"/>
                        </group>
                    </group>

                    <group string="📊 Formule" colspan="2">
                        <div style="background:#e8eaf6;border-radius:8px;padding:12px;">
                            <strong>Expression :</strong>
                            <code style="background:#fff;padding:4px 8px;border-radius:4px;display:inline-block;margin-top:4px;">
                                <field name="formula_expression" readonly="1" nolabel="1"/>
                            </code>
                            <div style="margin-top:8px;font-size:12px;color:#6c757d;">
                                <strong>Champs nécessaires :</strong>
                                <field name="formula_fields" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </group>

                    <group string="📝 Paramètres" colspan="2">
                        <field name="parameter_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Paramètre" readonly="1"/>
                                <field name="value" string="Valeur"/>
                                <field name="description" string="Description" optional="show"/>
                            </list>
                        </field>
                    </group>

                    <group string="📈 Résultat" colspan="2">
                        <div style="background:#f8f9fa;border-radius:8px;padding:15px;text-align:center;border:1px solid #dee2e6;">
                            <div style="font-size:14px;color:#6c757d;">Valeur calculée</div>
                            <div style="font-size:32px;font-weight:800;color:#1a237e;">
                                <field name="computed_value" readonly="1" nolabel="1"/>
                                <span style="font-size:18px;color:#6c757d;">
                                    <field name="unit" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </div>
                        <div style="margin-top:10px;">
                            <field name="comment" placeholder="Commentaire sur le calcul..."/>
                        </div>
                    </group>

                    <footer>
                        <button name="action_compute" string="🧮 Calculer" type="object" class="btn-primary"/>
                        <button name="action_save_measure" string="💾 Enregistrer la mesure" type="object" class="btn-success"/>
                        <button string="Fermer" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>