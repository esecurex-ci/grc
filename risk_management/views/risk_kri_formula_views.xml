<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- MODÈLES DE FORMULE - LISTE                -->
    <!-- ========================================= -->
    <record id="view_risk_kri_formula_template_list" model="ir.ui.view">
        <field name="name">risk.kri.formula.template.list</field>
        <field name="model">risk.kri.formula.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Nom"/>
                <field name="category" string="Catégorie" widget="badge"/>
                <field name="formula_expression" string="Formule" optional="show"/>
                <field name="unit" string="Unité" optional="show"/>
                <field name="active" string="Actif" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- MODÈLES DE FORMULE - FORMULAIRE           -->
    <!-- ========================================= -->
    <record id="view_risk_kri_formula_template_form" model="ir.ui.view">
        <field name="name">risk.kri.formula.template.form</field>
        <field name="model">risk.kri.formula.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du modèle..."/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="category"/>
                            <field name="unit"/>
                            <field name="measure_unit"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="expected_result"/>
                        </group>
                    </group>

                    <group string="🧮 Formule">
                        <group>
                            <field name="formula_expression" placeholder="Ex: (errors / total) * 100"/>
                            <field name="formula_fields" placeholder="errors, total"/>
                        </group>
                        <group>
                            <field name="sample_parameters" placeholder='{"errors": 5, "total": 100}'/>
                            <field name="description"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_apply_template"
                                string="📋 Appliquer ce modèle"
                                type="object"
                                class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- TEST DE FORMULE - ASSISTANT               -->
    <!-- ========================================= -->
    <record id="view_risk_kri_formula_test_wizard_form" model="ir.ui.view">
        <field name="name">risk.kri.formula.test.wizard.form</field>
        <field name="model">risk.kri.formula.test.wizard</field>
        <field name="arch" type="xml">
            <form string="🧪 Test de formule">
                <sheet>
                    <div class="oe_title">
                        <h1>🧪 Test de formule</h1>
                        <p class="text-muted">
                            Testez votre formule avant de l'appliquer à un KRI.
                        </p>
                    </div>

                    <group string="📝 Formule à tester">
                        <group>
                            <field name="formula_expression" placeholder="Ex: (errors / total) * 100"/>
                            <field name="formula_fields" placeholder="errors, total"/>
                        </group>
                    </group>

                    <group string="📊 Paramètres de test">
                        <field name="parameter_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Paramètre" readonly="1"/>
                                <field name="value" string="Valeur"/>
                                <field name="description" string="Description" optional="show"/>
                            </list>
                        </field>
                    </group>

                    <group string="📈 Résultat du test" colspan="2" invisible="test_result == 0">
                        <div style="background:#f8f9fa;border-radius:8px;padding:15px;text-align:center;border:1px solid #dee2e6;">
                            <div style="font-size:14px;color:#6c757d;">Résultat</div>
                            <div style="font-size:32px;font-weight:800;color:#1a237e;">
                                <field name="test_result" readonly="1" nolabel="1"/>
                            </div>
                            <div style="margin-top:5px;">
                                <span t-attf-class="badge #{test_success ? 'badge-success' : 'badge-danger'}">
                                    <field name="test_message" readonly="1" nolabel="1"/>
                                </span>
                                <span style="font-size:11px;color:#6c757d;margin-left:10px;">
                                    ⏱️ <field name="execution_time" readonly="1"/> ms
                                </span>
                            </div>
                        </div>
                    </group>

                    <footer>
                        <button name="action_test_formula" string="🧪 Tester" type="object" class="btn-primary"/>
                        <button string="Fermer" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- APPLICATION DE FORMULE - ASSISTANT        -->
    <!-- ========================================= -->
    <record id="view_risk_kri_formula_apply_wizard_form" model="ir.ui.view">
        <field name="name">risk.kri.formula.apply.wizard.form</field>
        <field name="model">risk.kri.formula.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="📋 Appliquer une formule">
                <sheet>
                    <div class="oe_title">
                        <h1>📋 Appliquer une formule</h1>
                        <p class="text-muted">
                            Appliquez une formule à un KRI existant.
                        </p>
                    </div>

                    <group>
                        <group>
                            <field name="kri_id" required="1" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="unit"/>
                            <field name="measure_unit"/>
                        </group>
                    </group>

                    <group string="🧮 Formule">
                        <group>
                            <field name="formula_expression" required="1"/>
                            <field name="formula_fields"/>
                        </group>
                        <group>
                            <field name="sample_parameters" readonly="1"/>
                            <field name="expected_result" readonly="1"/>
                        </group>
                    </group>

                    <group string="📊 Seuils" invisible="not apply_to_thresholds">
                        <group>
                            <field name="apply_to_thresholds"/>
                            <field name="threshold_green" string="🟢 Seuil Vert (OK)"/>
                            <field name="threshold_amber" string="🟡 Seuil Orange (Alerte)"/>
                            <field name="threshold_red" string="🔴 Seuil Rouge (Critique)"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_apply"
                                string="📋 Appliquer"
                                type="object"
                                class="btn-primary"
                                confirm="Voulez-vous vraiment appliquer cette formule au KRI sélectionné ?"/>
                        <button string="Fermer" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>