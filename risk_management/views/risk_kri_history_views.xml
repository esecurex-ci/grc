<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_risk_kri_formula_history_list" model="ir.ui.view">
        <field name="name">risk.kri.formula.history.list</field>
        <field name="model">risk.kri.formula.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="formula_version" string="Version"/>
                <field name="create_date" string="Date"/>
                <field name="created_by" string="Modifié par"/>
                <field name="formula_expression" string="Expression" optional="show"/>
                <field name="formula_fields" string="Champs" optional="show"/>
                <field name="threshold_green" string="Seuil Vert" optional="show"/>
                <field name="threshold_amber" string="Seuil Orange" optional="show"/>
                <field name="threshold_red" string="Seuil Rouge" optional="show"/>
                <field name="measure_frequency" string="Fréquence" optional="hide"/>
                <field name="tolerance" string="Tolérance" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_risk_kri_formula_history_form" model="ir.ui.view">
        <field name="name">risk.kri.formula.history.form</field>
        <field name="model">risk.kri.formula.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_restore_formula"
                            string="🔄 Restaurer cette version"
                            type="object"
                            class="btn-primary"
                            confirm="Voulez-vous vraiment restaurer cette version de la formule ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            📜 Version <field name="formula_version"/>
                            <small style="font-size:14px;color:#6c757d;">
                                du <field name="create_date"/>
                            </small>
                        </h1>
                        <span class="oe_subtitle">
                            <field name="kri_id"/> - Modifié par <field name="created_by"/>
                        </span>
                    </div>

                    <group string="🧮 Formule">
                        <group>
                            <field name="formula" placeholder="Méthode de calcul"/>
                            <field name="formula_expression" placeholder="Expression Python"/>
                            <field name="formula_fields" placeholder="Champs nécessaires"/>
                        </group>
                    </group>

                    <group string="📊 Seuils">
                        <group>
                            <field name="tolerance" string="Tolérance"/>
                            <field name="measure_frequency" string="Fréquence"/>
                        </group>
                        <group>
                            <field name="threshold_green" string="🟢 Seuil Vert"/>
                            <field name="threshold_amber" string="🟡 Seuil Orange"/>
                            <field name="threshold_red" string="🔴 Seuil Rouge"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>