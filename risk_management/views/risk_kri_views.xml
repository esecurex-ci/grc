<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- VUE LISTE HIÉRARCHIQUE - KRI             -->
    <!-- ========================================= -->
    <record id="view_risk_kri_hierarchical_list" model="ir.ui.view">
        <field name="name">risk.kri.hierarchical.list</field>
        <field name="model">risk.kri</field>
        <field name="arch" type="xml">
            <list
                string="KRI par processus"
                default_group_by="macro_process_id,process_id,activity_id"
                expand="0"
                decoration-success="status == 'green'"
                decoration-warning="status == 'amber'"
                decoration-danger="status == 'red'">



                <!-- Informations principales -->
                <field name="code" string="Code"/>
                <field name="name" widget="text" string="Nom du KRI" optional="show" class="text-wrap"/>
                <field name="category" string="Catégorie"/>
                <field name="activity_id" string="Activité"/>
                <!-- Risques associés -->
                <field name="risk_count" string="Risques" sum="Total" widget="statinfo"/>

                <!-- Propriétaire -->
                <field name="owner_id" string="Propriétaire" optional="show"/>

                <!-- Valeurs -->
                <field name="current_value" string="Valeur actuelle" sum="Total"/>
                <field name="unit" string="Unité" optional="hide"/>

                <!-- Statuts -->
                <field name="status" string="Statut" widget="badge"/>
                <field name="trend" string="Tendance" widget="badge"/>
                <field name="variation" string="Variation (%)" optional="hide"/>

                <!-- Dates -->
                <field name="last_measure_date" string="Dernière mesure" optional="show"/>
                <field name="next_measure_date" string="Prochaine mesure" optional="show"/>
                <field name="overdue" string="En retard" widget="boolean" optional="hide"/>

                <!-- Alertes -->
                <field name="alert_count" string="Alertes" widget="badge" optional="hide"/>

                <!-- Seuils -->
                <field name="threshold_green" string="🟢 Seuil vert" optional="hide"/>
                <field name="threshold_amber" string="🟡 Seuil orange" optional="hide"/>
                <field name="threshold_red" string="🔴 Seuil rouge" optional="hide"/>
                <field name="threshold_appetite" string="🎯 Seuil d'appétit" optional="hide"/>
                <field name="over_appetite" string="Hors appétit" widget="boolean" optional="hide"/>

                <!-- Actif -->
                <field name="active" string="Actif" widget="boolean" optional="hide"/>

            </list>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE LISTE - KRI                           -->
    <!-- ========================================= -->
   <record id="view_risk_kri_list" model="ir.ui.view">
        <field name="name">risk.kri.list</field>
        <field name="model">risk.kri</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'green'"
                  decoration-warning="status == 'amber'"
                  decoration-danger="status == 'red'">

                <!-- Informations principales -->
                <field name="code" string="Code"/>
                <field name="name" widget="text" string="Nom du KRI" optional="show" class="text-wrap"/>
                <field name="category" string="Catégorie"/>

                <!-- Risques associés -->
                <field name="risk_ids" string="Risques" optional="show"/>

                <!-- Processus et activités (via les risques) -->
                <field name="process_list" string="Processus" optional="show"/>
                <field name="activity_list" string="Activités" optional="show"/>

                <!-- Propriétaire -->
                <field name="owner_id" string="Propriétaire" optional="show"/>

                <!-- Valeurs -->
                <field name="current_value" string="Valeur actuelle" sum="Total"/>
                <field name="unit" string="Unité" optional="hide"/>

                <!-- Statuts -->
                <field name="status" string="Statut" widget="badge"/>
                <field name="trend" string="Tendance" widget="badge"/>
                <field name="variation" string="Variation (%)" optional="hide"/>

                <!-- Dates -->
                <field name="last_measure_date" string="Dernière mesure" optional="show"/>
                <field name="next_measure_date" string="Prochaine mesure" optional="show"/>
                <field name="overdue" string="En retard" widget="boolean" optional="hide"/>

                <!-- Alertes -->
                <field name="alert_count" string="Alertes" widget="badge" optional="hide"/>

                <!-- Seuils réellement utilisés par le calcul du statut -->
                <field name="threshold_green" string="🟢 Seuil vert" optional="hide"/>
                <field name="threshold_amber" string="🟡 Seuil orange" optional="hide"/>
                <field name="threshold_red" string="🔴 Seuil rouge" optional="hide"/>
                <field name="threshold_appetite" string="🎯 Seuil d'appétit" optional="hide"/>
                <field name="over_appetite" string="Hors appétit" widget="boolean" optional="hide"/>

                <!-- Actif -->
                <field name="active" string="Actif" widget="boolean" optional="hide"/>

            </list>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE FORMULAIRE - KRI                      -->
    <!-- ========================================= -->
    <record id="view_risk_kri_form" model="ir.ui.view">
        <field name="name">risk.kri.form</field>
        <field name="model">risk.kri</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_measure" string="➕ Ajouter une mesure" type="object" class="btn-primary"/>
                    <button name="action_view_measures" string="📊 Voir les mesures" type="object"/>
                    <button name="action_test_formula" string="🧪 Tester la formule" type="object" class="btn-secondary"/>
                    <button name="action_apply_formula_template" string="📋 Modèles de formules" type="object" class="btn-secondary"/>
                    <field name="status" widget="badge"/>
                    <field name="trend" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du KRI..."/>
                        </h1>
                        <span class="oe_subtitle">
                            <field name="code" placeholder="Code"/>
                        </span>
                    </div>

                    <group>
                        <group>
                            <field name="category"/>
                            <field name="owner_id"/>
                            <field name="unit"/>
                            <field name="measure_frequency"/>
                        </group>
                        <group>
                            <field name="current_value" readonly="1"/>
                            <field name="previous_value" readonly="1"/>
                            <field name="variation" readonly="1"/>
                            <field name="last_measure_date" readonly="1"/>
                            <field name="next_measure_date" readonly="1"/>
                            <field name="overdue" readonly="1"/>
                        </group>
                    </group>

                    <group string="🗂️ Rattachement (via les risques associés)">
                        <group colspan="2">
                            <field name="macro_process_list" string="Processus" readonly="1"/>
                            <field name="process_list" string="Sous-Processus" readonly="1"/>
                            <field name="activity_list" string="Activités" readonly="1"/>
                        </group>
                    </group>

                    <group string="Seuils de déclenchement">
                        <group>
                            <field name="threshold_green" string="🟢 Seuil Vert (OK)"/>
                            <field name="threshold_amber" string="🟡 Seuil Orange (Alerte)"/>
                            <field name="threshold_red" string="🔴 Seuil Rouge (Critique)"/>
                        </group>
                        <group>
                            <div class="alert alert-info">
                                <strong>📌 Légende :</strong><br/>
                                🟢 Vert : Seuil bas ≤ Valeur &lt; Seuil orange<br/>
                                🟡 Orange : Seuil orange ≤ Valeur &lt; Seuil rouge<br/>
                                🔴 Rouge : Valeur ≥ Seuil rouge
                            </div>
                        </group>
                    </group>

                    <group string="🎯 Appétit au risque">
                        <group>
                            <field name="threshold_appetite"/>
                            <field name="over_appetite" widget="boolean" readonly="1"/>
                        </group>
                        <group>
                            <div class="alert alert-warning">
                                <strong>📌 Distinct du pilotage vert/orange/rouge :</strong><br/>
                                Ce seuil représente la tolérance réelle du comité des risques,
                                pas l'alerte opérationnelle. Un KRI peut être 🟡 Orange sans être
                                hors appétit, ou l'inverse selon le seuil défini ici.
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="📝 Description">
                            <field name="description"/>
                        </page>
                        <page string="📊 Mesures">
                            <!-- ✅ CORRIGÉ : id au lieu de active_id -->
                            <field name="measure_ids" context="{'default_kri_id': id}">
                                <list editable="bottom" decoration-success="kri_id.status == 'green'" decoration-warning="kri_id.status == 'amber'" decoration-danger="kri_id.status == 'red'">
                                    <field name="measure_date"/>
                                    <field name="value" sum="Total"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="🔗 Risques associés">
                            <field name="risk_ids"/>
                        </page>
                        <page string="🚨 Alertes">
                            <field name="alert_ids">
                                <list decoration-warning="status == 'amber'" decoration-danger="status == 'red'">
                                    <field name="create_date"/>
                                    <field name="status" widget="badge"/>
                                    <field name="value"/>
                                    <field name="threshold"/>
                                    <field name="acknowledged" widget="boolean"/>
                                    <field name="resolved" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="📋 Plan d'action">
                            <field name="action_plan"/>
                            <field name="notes"/>
                        </page>
                        <page string="🧮 Formule" name="formula">
                            <group string="Méthode de calcul">
                                <field name="formula" placeholder="Description textuelle de la méthode de calcul..."/>
                            </group>
                            <group string="Expression de calcul">
                                <field name="formula_expression"
                                       placeholder="Ex: (errors / total) * 100"
                                       help="Expression Python pour le calcul automatique"/>
                                <field name="formula_fields"
                                       placeholder="errors, total"
                                       help="Champs requis pour le calcul (séparés par des virgules)"/>
                            </group>

                            <!-- ✅ AJOUT : Exemples de formules -->
                            <group string="📋 Exemples de formules" colspan="2">
                                <div style="background:#f8f9fa;border-radius:8px;padding:12px;border:1px solid #dee2e6;">
                                    <strong style="color:#1a237e;">Formules courantes :</strong>
                                    <table style="width:100%;margin-top:8px;font-size:12px;">
                                        <tr>
                                            <td style="padding:4px;"><strong>Taux d'erreur</strong></td>
                                            <td style="padding:4px;">(errors / total) * 100</td>
                                            <td style="padding:4px;color:#6c757d;">errors, total</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;"><strong>Écart en %</strong></td>
                                            <td style="padding:4px;">((actual - expected) / expected) * 100</td>
                                            <td style="padding:4px;color:#6c757d;">actual, expected</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;"><strong>Taux de conformité</strong></td>
                                            <td style="padding:4px;">(valid / total) * 100</td>
                                            <td style="padding:4px;color:#6c757d;">valid, total</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;"><strong>Variation</strong></td>
                                            <td style="padding:4px;">((current - previous) / previous) * 100</td>
                                            <td style="padding:4px;color:#6c757d;">current, previous</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;"><strong>Moyenne</strong></td>
                                            <td style="padding:4px;">sum_values / count</td>
                                            <td style="padding:4px;color:#6c757d;">sum_values, count</td>
                                        </tr>
                                    </table>
                                </div>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE RECHERCHE - KRI                       -->
    <!-- ========================================= -->
    <record id="view_risk_kri_search" model="ir.ui.view">
        <field name="name">risk.kri.search</field>
        <field name="model">risk.kri</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="owner_id"/>
                <filter name="status_green" string="🟢 Vert" domain="[('status', '=', 'green')]"/>
                <filter name="status_amber" string="🟡 Orange" domain="[('status', '=', 'amber')]"/>
                <filter name="status_red" string="🔴 Rouge" domain="[('status', '=', 'red')]"/>
                <filter name="overdue" string="⏰ En retard" domain="[('overdue', '=', True)]"/>
                <separator/>
                <filter name="group_category" string="Par catégorie" context="{'group_by': 'category'}"/>
                <filter name="group_status" string="Par statut" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- VUE KANBAN - KRI                          -->
    <!-- ========================================= -->
    <record id="view_risk_kri_kanban" model="ir.ui.view">
        <field name="name">risk.kri.kanban</field>
        <field name="model">risk.kri</field>
        <field name="arch" type="xml">
            <kanban class="o_risk_kri_kanban">
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <field name="current_value"/>
                <field name="unit"/>
                <field name="trend"/>
                <field name="variation"/>
                <field name="owner_id"/>
                <field name="category"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <span class="o_kanban_image_size">
                                    <i class="fa fa-gauge-high" style="font-size:32px;"/>
                                </span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="code"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_risk_kri_value">
                                        <span class="kri-value"><field name="current_value"/></span>
                                        <span class="kri-unit"><field name="unit"/></span>
                                    </div>
                                    <div class="o_risk_kri_meta">
                                        <span class="badge" t-attf-class="#{record.status.raw_value == 'green' ? 'badge-success' : record.status.raw_value == 'amber' ? 'badge-warning' : 'badge-danger'}">
                                            <field name="status"/>
                                        </span>
                                        <span class="badge badge-secondary">
                                            <field name="trend"/>
                                        </span>
                                        <span class="badge badge-info">
                                            Variation: <field name="variation"/>%
                                        </span>
                                    </div>
                                    <div class="o_risk_kri_owner">
                                        <i class="fa fa-user"/> <field name="owner_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- ACTION - KRI                             -->
    <!-- ========================================= -->
    <record id="action_risk_kri" model="ir.actions.act_window">
        <field name="name">KRI</field>
        <field name="res_model">risk.kri</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_risk_kri_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                📊 Gérez vos Indicateurs Clés de Risque
            </p>
            <p>
                Les KRI vous permettent de surveiller en temps réel l'évolution de vos risques.
            </p>
        </field>
    </record>

    <record id="view_risk_graph" model="ir.ui.view">
        <field name="name">risk.graph</field>
        <field name="model">risk.risk</field>
        <field name="arch" type="xml">
            <graph>
                <field name="macro_process_id"/>
                <field name="inherent_score" type="measure"/>
            </graph>
        </field>
    </record>

</odoo>