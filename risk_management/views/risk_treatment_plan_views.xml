<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- LIST -->
    <!-- ===================================================== -->

    <record id="view_risk_treatment_plan_list" model="ir.ui.view">
        <field name="name">risk.treatment.plan.list</field>
        <field name="model">risk.treatment.plan</field>
        <field name="arch" type="xml">
            <list
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress' and not is_overdue"
                  decoration-danger="is_overdue"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">

                <field name="code"/>
                <field name="name"/>
                <field name="risk_id"/>
                <field name="owner_id"/>
                <field name="owner_employee_id"/>
                <field name="target_date"/>
                <field name="days_remaining"/>
                <field name="is_overdue" widget="boolean" string="En retard"/>
                <field name="budget" widget="monetary"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- SEARCH -->
    <!-- ===================================================== -->

    <record id="view_risk_treatment_plan_search" model="ir.ui.view">
        <field name="name">risk.treatment.plan.search</field>
        <field name="model">risk.treatment.plan</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="code"/>
                <field name="risk_id"/>
                <field name="owner_id"/>
                <field name="owner_employee_id"/>

                <separator/>

                <filter name="draft"
                        string="Brouillon"
                        domain="[('state','=','draft')]"/>

                <filter name="in_progress"
                        string="En cours"
                        domain="[('state','=','in_progress')]"/>

                <filter name="completed"
                        string="Terminé"
                        domain="[('state','=','completed')]"/>

                <filter name="cancelled"
                        string="Annulé"
                        domain="[('state','=','cancelled')]"/>

                <separator/>

                <filter name="overdue"
                        string="En retard"
                        domain="[('is_overdue','=',True)]"/>

                <filter name="my_plans"
                        string="Mes plans"
                        domain="['|', ('owner_employee_id.user_id','=',uid), ('notification_user_ids','in',[uid])]"/>

                <separator/>

                <filter name="group_by_state" string="Grouper par statut" context="{'group_by':'state'}"/>
                <filter name="group_by_owner" string="Grouper par responsable" context="{'group_by':'owner_id'}"/>
                <filter name="group_by_risk" string="Grouper par risque" context="{'group_by':'risk_id'}"/>

            </search>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- FORM -->
    <!-- ===================================================== -->

    <record id="view_risk_treatment_plan_form" model="ir.ui.view">
        <field name="name">risk.treatment.plan.form</field>
        <field name="model">risk.treatment.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de traitement">
                <header>
                    <button name="action_start"
                            string="Démarrer"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_complete"
                            string="Terminer"
                            type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar"/>

                    <button name="notify_treatment_plan_created"
                        string="📢 Notifier"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'in_progress')"/>
                </header>

                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not is_overdue" style="margin-bottom:10px;">
                        <i class="fa fa-exclamation-triangle" title="En retard"/>
                        <strong>Ce plan est en retard</strong> — échéance dépassée.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="text-muted" readonly="1" placeholder="Code..."/>
                            <field name="name" placeholder="Nom du plan de traitement..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations générales">
                            <field name="assessment_id" required="1"/>
                            <field name="risk_id" readonly="1"/>
                            <field name="owner_id" placeholder="Fonction propriétaire"/>
                            <field name="owner_employee_id" placeholder="Employé responsable"/>
                        </group>
                        <group string="Dates">
                            <field name="target_date" required="1"/>
                            <field name="days_remaining" readonly="1"/>
                            <field name="is_overdue" readonly="1" widget="boolean"/>
                            <field name="completion_date" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <group string="Progression" colspan="2">
                        <field name="progress" widget="progressbar" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description du plan..." nolabel="1"/>
                        </page>
                        <page string="Budget">
                            <group>
                                <field name="budget" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notifications">
                            <group string="Utilisateurs à notifier">
                                <field name="notification_user_ids" widget="many2many_tags"
                                       placeholder="Sélectionnez les utilisateurs..."/>
                                <div class="alert alert-info" style="margin-top: 10px;">
                                    <i class="fa fa-info-circle"/>
                                    Les utilisateurs sélectionnés recevront les notifications
                                    lors de la création et des mises à jour du plan.
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- KANBAN -->
    <!-- ===================================================== -->

    <record id="view_risk_treatment_plan_kanban" model="ir.ui.view">
        <field name="name">risk.treatment.plan.kanban</field>
        <field name="model">risk.treatment.plan</field>
        <field name="arch" type="xml">

            <kanban default_group_by="state">

                <field name="name"/>
                <field name="code"/>
                <field name="risk_id"/>
                <field name="owner_id"/>
                <field name="target_date"/>
                <field name="progress"/>
                <field name="state"/>
                <field name="is_overdue"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click" t-attf-class="border-start border-4 #{record.is_overdue.raw_value ? 'border-danger' : 'border-transparent'}" style="padding:6px 10px;">

                            <div class="d-flex justify-content-between align-items-start">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger" title="En retard">
                                    ⏰ En retard
                                </span>
                            </div>

                            <div class="text-muted small">
                                <field name="risk_id"/>
                            </div>

                            <div class="mt-2">
                                <i class="fa fa-user" title="Responsable"/> <field name="owner_id"/>
                            </div>

                            <div class="mt-2">
                                <i class="fa fa-calendar" title="Échéance"/> Echéance :
                                <field name="target_date"/>
                            </div>

                            <div class="mt-3">
                                <field name="progress"
                                       widget="progressbar"/>
                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>

</odoo>